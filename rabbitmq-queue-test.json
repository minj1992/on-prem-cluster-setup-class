{
  "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
  },
  "id": 16,
  "type": "table",
  "title": "Queues",
  "description": "All queues combined, per RabbitMQ pod (each queue is counted on the pod that hosts it). Ready = waiting to be picked up. Unacked = picked up, not yet confirmed. Total = Ready + Unacked. Consumers = app listeners connected to that pod.",
  "gridPos": {
    "h": 6,
    "w": 24,
    "x": 0,
    "y": 26
  },
  "fieldConfig": {
    "defaults": {
      "custom": {
        "align": "auto",
        "cellOptions": {
          "type": "auto"
        },
        "filterable": true
      },
      "mappings": [],
      "thresholds": {
        "mode": "absolute",
        "steps": [
          {
            "color": "green",
            "value": null
          }
        ]
      }
    },
    "overrides": [
      {
        "matcher": {
          "id": "byName",
          "options": "Ready"
        },
        "properties": [
          {
            "id": "custom.cellOptions",
            "value": {
              "type": "color-background",
              "mode": "basic"
            }
          },
          {
            "id": "thresholds",
            "value": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 1000
                },
                {
                  "color": "red",
                  "value": 10000
                }
              ]
            }
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "Unacked"
        },
        "properties": [
          {
            "id": "custom.cellOptions",
            "value": {
              "type": "color-background",
              "mode": "basic"
            }
          },
          {
            "id": "thresholds",
            "value": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 1000
                },
                {
                  "color": "red",
                  "value": 10000
                }
              ]
            }
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "Consumers"
        },
        "properties": [
          {
            "id": "custom.cellOptions",
            "value": {
              "type": "color-background",
              "mode": "basic"
            }
          },
          {
            "id": "thresholds",
            "value": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "options": {
    "showHeader": true,
    "cellHeight": "md",
    "footer": {
      "show": false,
      "reducer": [
        "sum"
      ],
      "fields": ""
    },
    "sortBy": [
      {
        "displayName": "Ready",
        "desc": true
      }
    ]
  },
  "pluginVersion": "11.5.2",
  "targets": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "editorMode": "code",
      "expr": "sum by (pod) (rabbitmq_queue_messages_ready{namespace=~\"$namespace\",pod=~\"$pod\"})",
      "legendFormat": "__auto",
      "refId": "A",
      "range": false,
      "instant": true,
      "format": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "editorMode": "code",
      "expr": "sum by (pod) (rabbitmq_queue_messages_unacked{namespace=~\"$namespace\",pod=~\"$pod\"})",
      "legendFormat": "__auto",
      "refId": "B",
      "range": false,
      "instant": true,
      "format": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "editorMode": "code",
      "expr": "sum by (pod) (rabbitmq_queue_messages{namespace=~\"$namespace\",pod=~\"$pod\"})",
      "legendFormat": "__auto",
      "refId": "C",
      "range": false,
      "instant": true,
      "format": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "editorMode": "code",
      "expr": "sum by (pod) (rabbitmq_consumers{namespace=~\"$namespace\",pod=~\"$pod\"})",
      "legendFormat": "__auto",
      "refId": "D",
      "range": false,
      "instant": true,
      "format": "table"
    }
  ],
  "transformations": [
    {
      "id": "merge",
      "options": {}
    },
    {
      "id": "organize",
      "options": {
        "excludeByName": {
          "Time": true
        },
        "indexByName": {
          "pod": 0,
          "Value #A": 1,
          "Value #B": 2,
          "Value #C": 3,
          "Value #D": 4
        },
        "renameByName": {
          "pod": "RabbitMQ Pod",
          "Value #A": "Ready",
          "Value #B": "Unacked",
          "Value #C": "Total",
          "Value #D": "Consumers"
        }
      }
    }
  ]
}
